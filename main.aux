\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces {\bf  Left}: Sum of all the age posteriors for the full sample. The distribution of ages is peaked at young ages, but this is partially due to the inclusion of early-type stars with shorter main sequence lifetimes. {\bf  Right}: Sum of age posteriors for only stars with $B-V > 0.595$, where there is still a peak at young ages, if less pronounced than for the full sample.}}{52}{figure.caption.25}\protected@file@percent }
\newlabel{global_post}{{8.1}{52}{{\bf Left}: Sum of all the age posteriors for the full sample. The distribution of ages is peaked at young ages, but this is partially due to the inclusion of early-type stars with shorter main sequence lifetimes. {\bf Right}: Sum of age posteriors for only stars with $B-V > 0.595$, where there is still a peak at young ages, if less pronounced than for the full sample}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces {\bf  Left}: The combined age posterior from lithium detections and/or gyrochronology for the late-type stars in the sample. The peak at young ages is consistent with stars that are $<1$ Gyr being most likely to have detectable lithium or clear rotation signals. {\bf  Right}: For stars that only have lithium upper limits, the age posterior is mostly flat, following the prior, with only the youngest ages excluded.}}{53}{figure.caption.26}\protected@file@percent }
\newlabel{global_post_late}{{8.2}{53}{{\bf Left}: The combined age posterior from lithium detections and/or gyrochronology for the late-type stars in the sample. The peak at young ages is consistent with stars that are $<1$ Gyr being most likely to have detectable lithium or clear rotation signals. {\bf Right}: For stars that only have lithium upper limits, the age posterior is mostly flat, following the prior, with only the youngest ages excluded}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces {\bf  Left:} Ages derived from lithium alone yield an age distribution consistent with a constant star formation rate. $8\%$ of the combined distribution falls below 1 Gyr, which is consistent with the expected $7.7\%$. {\bf  Right:} Ages derived from gyrochronology alone yield a significantly younger age distribution than expected. For the {\color  {black} 20} late-type stars with rotation periods $\lesssim 15$ days, $92\%$ of the combined distribution of ages falls below 1 Gyr, which corresponds to {\color  {black} $\sim 17\%$} of the full gyrochronology sample.}}{54}{figure.caption.27}\protected@file@percent }
\newlabel{LiGyroPost}{{8.3}{54}{{\bf Left:} Ages derived from lithium alone yield an age distribution consistent with a constant star formation rate. $8\%$ of the combined distribution falls below 1 Gyr, which is consistent with the expected $7.7\%$. {\bf Right:} Ages derived from gyrochronology alone yield a significantly younger age distribution than expected. For the \rev {20} late-type stars with rotation periods $\lesssim 15$ days, $92\%$ of the combined distribution of ages falls below 1 Gyr, which corresponds to \rev {$\sim 17\%$} of the full gyrochronology sample}{figure.caption.27}{}}
