\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces {\color  {black} We use a 1 parameter fit to calibrate chromospheric S-values from APO/ARCES to values reported in the literature. We observe a $\sim 15\%$ scatter in the relationship, which we largely attribute to the intrinsic variability in chromospheric activity for each star. Error bars represent the maximum and minimum S-value reported in the literature for each star. We report S-values and $log(R'_{HK})$ for all the accelerating stars in Table \ref {tab:rhk}.}}}{26}{figure.caption.14}\protected@file@percent }
\newlabel{sval_calib}{{5.2}{26}{\rev {We use a 1 parameter fit to calibrate chromospheric S-values from APO/ARCES to values reported in the literature. We observe a $\sim 15\%$ scatter in the relationship, which we largely attribute to the intrinsic variability in chromospheric activity for each star. Error bars represent the maximum and minimum S-value reported in the literature for each star. We report S-values and $log(R'_{HK})$ for all the accelerating stars in Table \ref {tab:rhk}.}}{figure.caption.14}{}}
